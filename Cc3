#include <stdio.h>

int main() {
    int x, arr[20], n = 0;

    printf("Enter a number: ");
    scanf("%d", &x);

    while (x != 0) {
        arr[n++] = x % 10;
        x = x / 10;
    }

    printf("Reversed number: ");

    for (int i = 0; i < n; i++) {
        printf("%d", arr[i]);
    }

    return 0;
}
